  "dc:conformsTo": "http://cldf.clld.org/v1.0/terms.rdf#Generic",
  "dc:title": "Austronesian Sound Correspondence Dictionary",
  "dc:description": "Sourced proto-phoneme > reflex correspondences for Austronesian lects and proto-languages. Phoneme keys are (lect_id, symbol); the build derives the phoneme id '<lect_id>:<symbol>'.",
  "dialect": {
    "commentPrefix": null
  },
  "tables": [
    {
      "url": "sources.csv",
      "dc:description": "One citation. Must exist before its id is used anywhere else.",
      "tableSchema": {
        "columns": [
          {
            "name": "id",
            "required": true,
            "datatype": {
              "base": "string",
              "format": "[a-z0-9][a-z0-9_-]*"
            }
          },
          {
            "name": "author",
            "required": true
          },
          {
            "name": "year",
            "required": true
          },
          {
            "name": "title",
            "required": true
          },
          {
            "name": "url_or_doi"
          },
          {
            "name": "kind",
            "required": true,
            "datatype": {
              "base": "string",
              "format": "grammar|comparative|dictionary|database"
            }
          },
          {
            "name": "notes"
          },
          {
            "name": "year_suffix",
            "datatype": "string"
          },
          {
            "name": "pub_type",
            "datatype": "string"
          },
          {
            "name": "container_title",
            "datatype": "string"
          },
          {
            "name": "editors",
            "datatype": "string"
          },
          {
            "name": "volume",
            "datatype": "string"
          },
          {
            "name": "issue",
            "datatype": "string"
          },
          {
            "name": "pages",
            "datatype": "string"
          },
          {
            "name": "place",
            "datatype": "string"
          },
          {
            "name": "publisher",
            "datatype": "string"
          },
          {
            "name": "series",
            "datatype": "string"
          },
          {
            "name": "edition",
            "datatype": "string"
          }
        ],
        "primaryKey": [
          "id"
        ]
      }
    },
    {
      "url": "lects.csv",
      "dc:description": "A language, dialect or proto-language. inventory_status is derived by the build, not entered.",
      "tableSchema": {
        "columns": [
          {
            "name": "id",
            "required": true,
            "datatype": {
              "base": "string",
              "format": "[a-z0-9][a-z0-9_-]*"
            }
          },
          {
            "name": "name",
            "required": true
          },
          {
            "name": "alt_names",
            "separator": ";"
          },
          {
            "name": "type",
            "required": true,
            "datatype": {
              "base": "string",
              "format": "language|dialect|proto-language"
            }
          },
          {
            "name": "glottocode",
            "propertyUrl": "http://cldf.clld.org/v1.0/terms.rdf#glottocode",
            "datatype": {
              "base": "string",
              "format": "[a-z0-9]{4}[0-9]{4}"
            }
          },
          {
            "name": "iso639_3",
            "propertyUrl": "http://cldf.clld.org/v1.0/terms.rdf#iso639P3code",
            "datatype": {
              "base": "string",
              "format": "[a-z]{3}"
            }
          },
          {
            "name": "parent_id"
          },
          {
            "name": "subgroup_path",
            "separator": ">"
          },
          {
            "name": "region"
          },
          {
            "name": "orthography_note"
          },
          {
            "name": "notes"
          },
          {
            "name": "default_system",
            "datatype": "string"
          },
          {
            "name": "systems",
            "datatype": "string"
          },
          {
            "name": "clade",
            "datatype": "string"
          },
          {
            "name": "competes_with",
            "datatype": "string"
          },
          {
            "name": "latitude",
            "datatype": "string"
          },
          {
            "name": "longitude",
            "datatype": "string"
          },
          {
            "name": "overlap_groups",
            "datatype": "string"
          },
          {
            "name": "inherit",
            "datatype": "string"
          },
          {
            "name": "language_id",
            "datatype": "string"
          },
          {
            "name": "alt_parents",
            "datatype": "string"
          },
          {
            "name": "inherit_source_id",
            "datatype": "string"
          },
          {
            "name": "inherit_page",
            "datatype": "string"
          },
          {
            "name": "inherit_note",
            "datatype": "string"
          },
          {
            "name": "tree_parent"
          },
          {
            "name": "representative"
          }
        ],
        "primaryKey": [
          "id"
        ],
        "foreignKeys": [
          {
            "columnReference": [
              "parent_id"
            ],
            "reference": {
              "resource": "lects.csv",
              "columnReference": [
                "id"
              ]
            }
          }
        ]
      }
    },
    {
      "url": "phonemes.csv",
      "dc:description": "Hand-entered phoneme rows: origin = sourced | manual-add | suppressed. Generated rows are produced by the build and never stored here.",
