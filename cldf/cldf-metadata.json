            }
          },
          {
            "name": "place"
          },
          {
            "name": "manner"
          },
          {
            "name": "voicing"
          },
          {
            "name": "rounding"
          },
          {
            "name": "origin",
            "required": true,
            "datatype": {
              "base": "string",
              "format": "sourced|manual-add|suppressed"
            }
          },
          {
            "name": "source_id"
          },
          {
            "name": "page"
          },
          {
            "name": "reason"
          },
          {
            "name": "notes"
          },
          {
            "name": "via_source_id",
            "datatype": "string"
          },
          {
            "name": "via_page",
            "datatype": "string"
          },
          {
            "name": "via_note",
            "datatype": "string"
          },
          {
            "name": "status",
            "datatype": "string"
          }
        ],
        "primaryKey": [
          "lect_id",
          "ipa"
        ],
        "foreignKeys": [
          {
            "columnReference": [
              "lect_id"
            ],
            "reference": {
              "resource": "lects.csv",
              "columnReference": [
                "id"
              ]
            }
          },
          {
            "columnReference": [
              "source_id"
            ],
            "reference": {
              "resource": "sources.csv",
              "columnReference": [
                "id"
              ]
            }
          }
        ]
      }
    },
    {
      "url": "correspondences.csv",
